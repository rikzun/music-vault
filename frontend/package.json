{
  "name": "music-vault",
  "version": "1.0.0",
  "author": "rikzun",
  "scripts": {
    "start": "cross-env NODE_OPTIONS='--experimental-transform-types' rspack serve",
    "build": "cross-env NODE_ENV=production NODE_OPTIONS='--experimental-transform-types' rspack build",
    "dev-build": "cross-env NODE_ENV=production NODE_OPTIONS='--experimental-transform-types' rspack build -o ../build/frontend",
    "local": "cross-env NODE_OPTIONS='--experimental-transform-types' APP_URL=http://localhost:3001 rspack serve"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.9",
    "axios": "^1.13.6",
    "comlink": "^4.4.2",
    "jotai": "^2.18.0",
    "mitt": "^3.0.1",
    "music-metadata": "^11.12.1",
    "overlayscrollbars": "^2.14.0",
    "overlayscrollbars-react": "^0.5.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "xxhash-wasm": "^1.1.0"
  },
  "devDependencies": {
    "@rspack/cli": "^1.7.7",
    "@rspack/core": "^1.7.7",
    "@rspack/plugin-react-refresh": "^1.6.1",
    "@svgr/webpack": "^8.1.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/wicg-file-system-access": "^2023.10.7",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "react-refresh": "^0.18.0",
    "sass-embedded": "^1.97.3",
    "sass-loader": "^16.0.7",
    "ts-checker-rspack-plugin": "^1.3.0",
    "typescript": "^5.9.3"
